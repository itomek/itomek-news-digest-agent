{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "news-digest-web",
  "compatibility_date": "2026-06-02",
  "observability": {
    "enabled": true
  },
  "build": {
    "command": "cd web && npm ci && npm run build"
  },
  "assets": {
    "directory": "web/dist"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
