# Supabase (News Digest project — NOT Command Center)
SUPABASE_URL=https://<PROJECT_ID>.supabase.co
SUPABASE_ANON_KEY=<your-anon-key>
SUPABASE_SERVICE_KEY=<your-service-role-key>

# Lemonade Server (local LLM inference)
LEMONADE_BASE_URL=http://localhost:8000/api/v1
# Set after running issue #2 (Lemonade model inventory)
LEMONADE_LIGHT_MODEL=
LEMONADE_HEAVY_MODEL=

# Local storage paths (relative to project root)
SQLITE_PATH=data/news_digest.db
FALLBACK_LOG_PATH=data/system_logs_fallback.sqlite

# Logging level: debug | info | warn | error
LOG_LEVEL=info

# Scheduler — times are in UTC
SCHEDULE_DAILY_HOUR=10
SCHEDULE_DAILY_MINUTE=0
SCHEDULE_WEEKLY_DAY=sun
SCHEDULE_WEEKLY_HOUR=3
SCHEDULE_WEEKLY_MINUTE=0
